# Copy this file to `.env` (in this `backend/` directory) before running
# `make up`, `make dev`, `make dev-be`, `make dev-worker` or `make migrate`
# from the repo root -- none of those targets create `.env` for you, and
# without it they fail (missing DATABASE_URL) or fall back to defaults that
# don't match docker-compose.yml's ports.
#
#   cp backend/.env.example backend/.env
#
# `.env` itself is gitignored (it's a per-developer file, and
# STUDIO_SENTINEL_SERVICE_KEY is a real secret in any non-local environment)
# -- this checked-in `.env.example` is what a new clone actually has.
#
# STUDIO_CORS_ORIGINS is a JSON list, and it MUST be single-quoted exactly as
# below. The Makefile loads this file into the shell with
# `set -a && . ./.env && set +a`, which strips *unquoted* value text as
# normal shell word-splitting; `["http://localhost:3003"]` unquoted breaks
# into separate shell tokens and pydantic-settings then fails to parse the
# mangled leftover with `SettingsError: error parsing value for field
# "cors_origins"` -- the backend refuses to start. Single-quoting keeps the
# brackets and quotes intact through the shell so pydantic-settings' own JSON
# decoding of the value succeeds. Every other value here is a plain scalar,
# where quoting is optional.

# Ports: Postgres 5435, backend 8002, Valkey 6381 (see docker-compose.yml --
# 5434/8001/6380 are taken by a sibling project on this machine).
STUDIO_DATABASE_URL=postgresql+asyncpg://studio:studio@localhost:5435/studio
STUDIO_REDIS_URL=redis://localhost:6381
STUDIO_BLOB_BASE_URL=file:///tmp/daikon-studio-blobs
STUDIO_CORS_ORIGINS='["http://localhost:3003"]'

# Run training/prediction jobs in-process instead of via arq+Valkey -- the
# escape hatch for local dev or a laptop with no Redis running. Unset (or 0)
# to exercise the real arq worker (`make dev-worker`).
STUDIO_INLINE_JOBS=1

# Sentinel (shared identity service realm "daikon-siblings": prot-cellar,
# chem-cellar, daikon-gen3, docu-store). Sentinel is the ONE service this
# project talks to that does not run on your laptop -- every sibling follows
# the same rule, and running a local Sentinel is not required or expected.
#
# The two credentials below are blank on purpose. An empty
# STUDIO_SENTINEL_SERVICE_KEY is the documented missing-config signal (see
# settings.py): the auth dependency rejects every request rather than quietly
# letting them through, so a fresh clone fails loudly instead of appearing to
# work. Get your key by registering a Service App in the Sentinel admin panel
# -- that is an operator step in Sentinel, never a change in this repo.
STUDIO_SENTINEL_URL=https://sentinel.orca-03.biobio.tamu.edu
# The name Sentinel knows this deployment by, and it must match the name the
# service key was issued against -- a mismatch fails as
# `403 "Authz token was issued for a different service"`, which is a
# registration fact and must not be worked around in code. Matches
# frontend/.env.local's APP_SENTINEL_SERVICE_NAME.
STUDIO_SENTINEL_SERVICE_NAME=daikon-studio-dev
STUDIO_SENTINEL_SERVICE_KEY=
# Google is the IdP for this realm, so these are Google's own endpoints, not
# Sentinel's. STUDIO_IDP_AUDIENCE is the realm's Google OAuth client id --
# the same value frontend/.env.local puts in APP_SENTINEL_GOOGLE_CLIENT_ID.
STUDIO_IDP_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs
STUDIO_IDP_AUDIENCE=
STUDIO_IDP_ISSUER=https://accounts.google.com
