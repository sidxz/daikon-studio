# GPU-lane worker, CUDA. There is deliberately no sibling "Dockerfile.mps".
#
# The gpu lane has two backends and only one of them is an image. Docker Desktop on
# macOS runs a Linux VM that cannot see Metal -- there is no Mac equivalent of
# `--gpus all` -- so a Mac "GPU image" would silently train on CPU inside the
# container, strictly worse than the native path. On Apple Silicon the gpu lane is a
# native runner agent (`make dev-worker-gpu`), where lightning's `accelerator="auto"`
# resolves to MPS and a real chemprop fit runs on `mps:0`. This file is the CUDA
# backend for the same lane; the engines and the lane routing are identical.
#
# Build this on x86_64 (CI or a swarm node), not on an Apple Silicon Mac. The target is
# linux/amd64, so a Mac must build it under `--platform linux/amd64` QEMU emulation,
# which pushes several GB of torch and vendored CUDA through an emulator: measured here,
# dependency download alone took 7m05s and the bytecode-compile step did not finish
# inside 10 minutes. Nothing is wrong with the file -- it is the wrong machine.
#
# pytorch/pytorch:2.6.0-cuda12.4-cudnn9-runtime is the obvious base and is ruled out: it
# ships Python 3.11, and this codebase uses PEP 695 generics (`class PageResult[T]` in
# domain/shared/pagination.py) which need 3.12+. Lowering requires-python to fit a base
# image would be the tail wagging the dog; uv installs its own interpreter, so the plain
# CUDA runtime is the cleaner floor.
FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04

# There IS an apt step, and it is not optional -- an earlier revision of this file said
# "no apt step on purpose" and that was wrong. chemprop 2.3's featurizer imports
# `cuik_molmaker`, whose bundled libcuik_molmaker_core.so links libXrender, libXext and
# libexpat, and this base image ships none of them. Without these packages the image
# builds perfectly and then dies on the first chemprop run with `ImportError:
# libXrender.so.1: cannot open shared object file`. A GPU image that cannot import the
# only engine it exists to run is worse than no image, and a green build says nothing
# about it -- this was found by running the first successful build, not by reading it.
#
# The list is exactly what `ldd` reports as missing, resolved iteratively in a throwaway
# container until `import chemprop` succeeded, rather than guessed. Verified 2026-08-06
# against chemprop 2.3.0. If a future chemprop bumps cuik_molmaker, re-run:
#   ldd /app/.venv/lib/python3.13/site-packages/cuik_molmaker/lib/libcuik_molmaker_core.so | grep 'not found'
#
# The nvidia list is removed first, deliberately. The original objection to apt was real:
# `apt-get update` made the build depend on developer.download.nvidia.com's mirror, which
# is exactly what failed the first time ("File has unexpected size ... Mirror sync in
# progress?"). Dropping the cuda source keeps that mirror out of the build while still
# reaching Ubuntu's own archive, so the objection is answered rather than ignored.
RUN rm -f /etc/apt/sources.list.d/cuda*.list /etc/apt/sources.list.d/nvidia*.list \
 && apt-get update \
 && apt-get install -y --no-install-recommends libxrender1 libxext6 libexpat1 libgomp1 \
 && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PYTHON_INSTALL_DIR=/opt/uv-python
RUN uv python install 3.13

WORKDIR /app

# Torch comes from the lock, not from a CUDA index pinned here.
#
# An earlier draft set UV_INDEX=pytorch-cu124 at this point, claiming it was where the
# CUDA build got selected. Under `uv sync --frozen` that is dead config: frozen installs
# exactly the artifacts uv.lock names, and uv.lock resolves torch 2.13.0 from pypi.org
# (`grep -c download.pytorch.org uv.lock` -> 0). The env var changed nothing, so it is
# gone rather than left behind to be believed.
#
# It is not needed either. PyPI's linux torch wheels vendor their own CUDA userspace as
# the nvidia-*-cu13 dependency wheels, so the runtime CUDA that matters is bundled, not
# inherited from the base image. What the HOST must supply is a driver new enough for
# the CUDA major the locked torch was built against -- see the CUDA note in
# docs/roadmap.md. Keeping the cu124 index out of pyproject.toml is still right, for
# the reason recorded there: it would break `uv sync --extra gpu` on a developer's Mac,
# where the plain PyPI wheel is what reaches the Mac's own GPU through MPS.

# Both extras in ONE sync. Extras are not additive across separate `uv sync` runs --
# a second `uv sync --extra gpu` uninstalls what `--extra s3` put there.
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --extra gpu --extra s3 --no-install-project

# Bake CheMeleon in so a production worker never reaches Zenodo, and an
# air-gapped deployment works. 34,859,448 bytes, MIT licensed.
#
# ADD's remote-URL form, not curl: this base image's curl exists only long enough to
# fetch the cuda-keyring deb, then the base layer runs `apt-get purge --autoremove -y
# curl` -- confirmed against nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04 directly,
# which has neither curl nor wget. BuildKit fetches an `ADD <url>` from the builder
# itself, so it needs no client binary in the image at all. Do not "clean this up" back
# to curl; it will not build.
ENV STUDIO_PRETRAINED_WEIGHTS_DIR=/opt/weights
ADD https://zenodo.org/records/15460715/files/chemeleon_mp.pt /opt/weights/chemeleon_mp.pt
RUN echo "6a80b54fdb7de37ef0374d302f01e8ce  /opt/weights/chemeleon_mp.pt" | md5sum -c -

COPY src ./src
RUN uv sync --frozen --no-dev --extra gpu --extra s3

# TMPDIR is where chemprop's checkpoint round-trip lands. Bind a fast local NVMe at
# /scratch on a node that has one; everything written there is transient.
ENV PATH="/app/.venv/bin:$PATH" \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility \
    TMPDIR=/scratch

RUN mkdir -p /scratch \
 && useradd --create-home --uid 10001 studio \
 && chown -R studio /app /scratch /opt/weights
# OMP_NUM_THREADS=1 is load-bearing, not tuning. torch and scikit-learn each ship
# their own OpenMP runtime, and a training job loads BOTH -- RunTraining fits the
# chosen engine and the mandatory ECFP4 baseline in one process, by design. Multiple
# OpenMP runtimes in one process is undefined behaviour; on macOS it segfaults in
# __kmp_fork_barrier partway through a real chemprop fit. Setting it here so the
# deployed worker cannot hit the same wall hours into a GPU run.
# ponytail: costs intra-op parallelism in the baseline fit. Raise it only with a
# measurement showing this platform does not have the duplicate-runtime problem.
ENV OMP_NUM_THREADS=1

USER studio

# CMD is already the runner agent (unlike backend/Dockerfile, whose default CMD serves
# the API and needs its own CMD override). Set env vars STUDIO_URL (server address, an
# address THIS container can reach -- not necessarily the browser's own address the
# runners UI defaults to) and STUDIO_RUNNER_TOKEN (auth token) at `docker run` time, plus
# `--gpus all` so the container can see the host GPU.
CMD ["python", "-m", "daikonstudio.infrastructure.runner"]
