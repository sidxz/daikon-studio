# Frontend env -- copy to frontend/.env.local and fill in the secret. Never commit .env.local.
#
# Every APP_* variable is read at *request time* by /api/config, never baked at
# build time, so one Docker image works in every environment. There is no
# NEXT_PUBLIC_ fallback on purpose: those would be baked into the client bundle,
# and the fallback path only fires when a Next app fails to serve its own route.

APP_URL=http://localhost:3003
APP_API_BASE_URL=http://localhost:8002
APP_ENV=development

# Sentinel -- the shared realm with chem-cellar, prot-cellar, daikon-gen3 and
# docu-store. APP_SENTINEL_SERVICE_KEY is server-side only: /api/auth/mint uses
# it to forward token minting to Sentinel, and it is never sent to the browser.
# Use the same service key the backend's STUDIO_SENTINEL_SERVICE_KEY holds.
APP_SENTINEL_URL=https://sentinel.orca-03.biobio.tamu.edu
APP_SENTINEL_SERVICE_NAME=daikon-studio-dev
APP_SENTINEL_SERVICE_KEY=

# IdP client ids (Google -- the same OAuth client the sibling apps use).
APP_SENTINEL_GOOGLE_CLIENT_ID=
APP_SENTINEL_ENTRA_CLIENT_ID=
APP_SENTINEL_ENTRA_TENANT_ID=
