# Frontend env -- copy to frontend/.env.local and fill in the secret. Never commit .env.local.
#
# Every APP_* variable is read at *request time* by /api/config, never baked at
# build time, so one Docker image works in every environment. There is no
# NEXT_PUBLIC_ fallback on purpose: those would be baked into the client bundle,
# and the fallback path only fires when a Next app fails to serve its own route.

APP_URL=http://localhost:3003
APP_API_BASE_URL=http://localhost:8002
APP_ENV=development

# Duar -- the shared realm with chem-cellar, prot-cellar, daikon-gen3 and
# docu-store. APP_DUAR_SERVICE_KEY is server-side only: /api/auth/mint uses
# it to forward token minting to Duar, and it is never sent to the browser.
# Use the same service key the backend's STUDIO_DUAR_SERVICE_KEY holds.
APP_DUAR_URL=https://duar.orca-03.biobio.tamu.edu
APP_DUAR_SERVICE_NAME=daikon-studio-dev
APP_DUAR_SERVICE_KEY=

# ChemCellar web app URL; shows "From ChemCellar" on Run a protocol. Leave empty to hide it.
APP_CHEMCELLAR_URL=

# IdP client ids (Google -- the same OAuth client the sibling apps use).
APP_DUAR_GOOGLE_CLIENT_ID=
APP_DUAR_ENTRA_CLIENT_ID=
APP_DUAR_ENTRA_TENANT_ID=
